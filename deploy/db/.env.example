# Copia este archivo a .env (mismo folder) y cambia las passwords.
# Solo letras y números: la de zeroscam va dentro de una URL.
# Se fijan la PRIMERA vez que arranca la base; cambiarlas después aquí no
# cambia las de MySQL.

MYSQL_ROOT_PASSWORD=cambia_esto
# La misma va en deploy/back/.env de la PC del back.
MYSQL_APP_PASSWORD=cambia_esto_tambien

MYSQL_PORT=3306
# IP de esta PC en la VLAN de la base: MySQL solo escucha ahí.
# 0.0.0.0 = todas las interfaces (si la IP no es fija).
MYSQL_BIND=192.168.10.10

# Respaldo automático: cada cuántas horas y cuántos días se conservan (RNF06).
# Los archivos quedan en deploy/db/respaldos. Cópialos de vez en cuando a otra
# PC o disco: si se pierde esta PC, se pierden también.
RESPALDO_CADA_HORAS=24
RESPALDO_DIAS=30
